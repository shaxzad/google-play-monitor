# MongoDB connection. Local or Atlas connection strings both work.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=google_play_monitor

# Delay between app fetches, in milliseconds (rate-limiting safety).
SCRAPE_DELAY_MS=1500

# Delay between review-page fetches, in milliseconds.
REVIEW_DELAY_MS=2000

# Default Google Play store locale used by the provider.
GOOGLE_PLAY_COUNTRY=us
GOOGLE_PLAY_LANGUAGE=en
